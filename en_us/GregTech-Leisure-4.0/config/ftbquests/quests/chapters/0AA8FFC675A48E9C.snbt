								"{\"text\":\"This prefabricated template is only for use in multi-block structures of electric detonation compressors\",\"color\":\"gray\",\"italic\":false}"
								"{\"text\":\"Right-click on the super sample assembly inside the multi-block structure of the electric detonation compressor\",\"color\":\"gray\",\"italic\":false}"
								"{\"text\":\"\",\"italic\":false}"
								"{\"text\":\"[template type included]\",\"color\":\"gold\",\"italic\":false,\"bold\":true}"
								"{\"text\":\"Ore finished product, singularity\",\"color\":\"yellow\",\"italic\":false}"
								"{\"text\":\"\",\"italic\":false}"
								"{\"text\":\"⚠ This item is a disposable item. Right-click with caution\",\"color\":\"red\",\"italic\":false}"
								"{\"text\":\"If not in use, please put it in a separate box\",\"color\":\"red\",\"italic\":false}"
								"{\"text\":\"Do not put it in AE as it will cause NBT to explode\",\"color\":\"red\",\"italic\":false}"
								"{\"text\":\"----------------\",\"color\":\"dark_gray\",\"italic\":false}"
							]
							Name: "{\"text\":\"Electric implosion compressor-prefabricated sample\",\"italic\":false,\"color\":\"aqua\"}"
						}
					}
				}
				type: "item"
			}]
