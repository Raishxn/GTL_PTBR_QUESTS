		}
		{
			description: [
				"Is the EU/t provided to the multi-block structure greater than the EU/t provided to the recipe?"
				"Has the maintenance warehouse been maintained?"
				"Are any special requirements that may be met?"
				"Are items and fluids correctly entered into the bus/bin/product?"
				"Is the output space large enough?"
				"Is the muffler chamber facing the air block?"
				"Maybe a multi-block structure has been formed, but you forgot about a bin."
			]
			icon: "gtceu:maintenance_hatch"
			id: "498CB29FA7447C46"
			rewards: [{
				exclude_from_claim_all: true
				id: "4C362D7D07573B39"
