				title: "Other tips"
				type: "checkmark"
			}]
			x: -6.0d
			y: -4.0d
		}
		{
			description: [
				"This mission contains some important information during the game."
				""
				"This set of quests is designed to guide you through key milestones in GregTech's progression."
				""
				"It is recommended to play in Peaceful mode, as hostile mobs bring little benefit."
				""
				"You can use map teleportation, adjust game rules, etc. as you see fit."
				""
				"{\"text\":\"The most important thing is that GregTech will have very complex recipes and you need to be proficient in using JEI first.\",\"italic\":\"true\",\"underlined\":\"true\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"575A2A1E4F56FF34\"}}"
			]
			hide_dependent_lines: true
			icon: "minecraft:command_block_minecart"
