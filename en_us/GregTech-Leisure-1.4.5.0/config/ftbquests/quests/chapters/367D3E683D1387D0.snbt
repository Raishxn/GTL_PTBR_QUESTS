	quests: [
		{
			description: [
				"Is the EU/t given for the multiblock structure greater than the EU/t given for the recipe?"
				"Was the maintenance warehouse maintained?"
				"Are there special requirements that can be met?"
				"Are items and fluids correctly inserted into the bus/waste/product?"
				"Is the output space big enough?"
				"Is the muffler chamber facing the air block?"
				"Perhaps a multi-block structure was formed, but you forgot about a bin."
			]
			icon: "gtceu:maintenance_hatch"
			id: "498CB29FA7447C46"
			rewards: [{
				id: "6F0F202CEF4CCFD7"
