    {
      "id": "4B51EEA9FC0829EF",
      "title": "Continue from the restraint press workshop",
      "subtitle": "Coating, polymerization, annealing, and then to resonant lattice",
      "description": "[
        \"The HCV casing and the front-end nanotechnology are ready. In this stage, the polymerization, annealing and precision processing of the soul steel will be integrated, and then the resonant lattice and the first batch of HRV casings will be manufactured.\",
        \"There are injectors that continue to supply HW. The coating group has a batch of 192,000 HW, and the rough polymerization and annealing have 460,800 HW each. Before starting, prepare the account balance for those bound to the same controller.\"
      ]",
      "tasks": [
        {
          "id": "4B54BBF74370B91C",
          "type": "item",
          "item": "hk3gtl:voltage_machine_casing_hcv",
          "count": 1,
          "consume_items": false
        },
