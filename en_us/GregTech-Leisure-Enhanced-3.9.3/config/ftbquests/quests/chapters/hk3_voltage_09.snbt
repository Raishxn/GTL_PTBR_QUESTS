    },
    {
      "id": "4B50716301E829FE",
      "title": "Imaginary topology directed interconnection network",
      "subtitle": "Wire each work area individually",
      "description": [
        "\"The connection unit of the front platform interconnection network is used, and independent branches are connected with ceramic composite thin wires. The dielectric film is left between each branch for subsequent substrate and functional array use.\""
      ],
      "dependencies": [
        "4B5487FC42B1F9B4",
