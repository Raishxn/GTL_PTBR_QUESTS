    },
    {
      "id": "4B5D8A011ADB9399",
      "title": "Imaginary number topology circuit substrate",
      "subtitle": "Press the new circuit onto the physical substrate",
      "description": [
        "\"The front platform substrate serves as the base, and the printed board retains the old interface. The new film, interconnection network and etching layer are laminated together to obtain the carrier substrate for the imaginary topology circuit.\""
      ],
      "dependencies": [
        "4B50716301E829FE"
      ],
      "tasks": [
