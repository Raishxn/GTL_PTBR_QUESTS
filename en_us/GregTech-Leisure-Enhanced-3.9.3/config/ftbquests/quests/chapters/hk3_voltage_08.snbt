    {
      "id": "4B535AC10CB8CB3B",
      "title": "Imitation of the One Thousand Realms",
      "subtitle": "RN-CJK · Experimental and formal research",
      "description": [
        "\"Tested object: imitation Herrscher of the Sky core × 1; paper 2 is used for testing records, and the reference sample is recycled\"",
