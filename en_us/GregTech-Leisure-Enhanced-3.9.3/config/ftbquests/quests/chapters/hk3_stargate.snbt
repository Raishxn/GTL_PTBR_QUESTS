    {
      "id": "4B5F161707432FE4",
      "title": "reaction chamber",
      "subtitle": "The polymerization unit outputs two per batch",
      "description": [
        "\"Feed the shields and marshmallow hearts into the polymerization unit. Each batch will produce two reaction chambers, which will be used by the door knocker, base and Pegasus DHD.\"",
        "\"Dragon's steady-state core is placed in the non-consuming input and will be retained after completing this batch.\""
      ],
      "tasks": [
