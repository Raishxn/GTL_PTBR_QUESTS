    {
      "id": "4B552042CD67B9A1",
      "title": "Pegasus DHD",
      "subtitle": "This assembly line runs parallel to the door body",
      "description": [
        "\"Make the Pegasus DHD using the frame, beacon upgrade, shields, reaction chamber, and crystal pedestal, along with the Chaos Blocks and the remaining inputs in the recipe.\"",
        "\"Leave the console near the star gate. Before leaving, write down the address of this gate in the base. You will need it on the return trip.\""
      ],
