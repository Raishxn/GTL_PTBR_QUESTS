  "quests": [
    {
      "id": "4B557312C16A1494",
      "title": "empty space on star chart",
      "subtitle": "This time, let’s go and see for ourselves",
      "description": [
        "\"Yu Da spread out several observation records on the table and pointed to the same area on the star map.\"",
        "These readings all point to this. ",
        "\"The existing route cannot get there. You move the star map next to the space research information and plan to find a way there yourself.\""
      ],
      "tasks": [
        {
          "id": "4B502D5DF3D9133E",
          "type": "checkmark",
          "title": "Read travel plans",
          "tags": [
            "hk3gtl_quest_stargate_start"
          ]
        }
      ],
      "dependencies": [
        "516498830339A0A9"
      ],
      "x": 0,
      "y": 8,
      "icon": "minecraft:compass"
    },
    {
      "id": "4B5F9880439C3AC6",
      "title": "The barrel of whales swallowing the ocean",
      "subtitle": "The tea production line will consume it",
      "description": [
        "\"Each batch of tea recipes will consume 1024 barrels of whales swallowing the ocean. Please arrange the source of the barrels first.\"",
        "\"This assembly line recipe also requires the use of the Ocean Whale Barrel as a research sample.\""
      ],
