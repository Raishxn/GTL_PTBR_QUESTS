    {
      "id": "4B5780A4766B61FA",
      "title": "Stargate Radiation Protection Panel",
      "subtitle": "Connected to the hyperspace assembly line",
      "description": [
        "\"The protective plate is used in the reaction chamber, door knocker, base and Pegasus DHD. It will be used in subsequent assembly.\"",
        "\"The research on the cosmic stargate guide also requires a piece of protective plate as a sample. Let's leave one for the research station first.\""
      ],
      "tasks": [
        {
          "id": "4B55220FF0DFB2E4",
          "type": "item",
