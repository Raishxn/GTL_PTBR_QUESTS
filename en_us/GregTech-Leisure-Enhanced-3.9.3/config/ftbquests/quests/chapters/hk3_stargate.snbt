      "icon": "sgjourney:classic_stargate_base_block"
    },
    {
      "id": "4B51AD5256FB6064",
      "title": "It's connected over there",
      "subtitle": "Let the first wormhole open stably",
      "description": [
        "\"Add up the energy required for dialing, select the address, and wait for DHD to report the connection result.\"",
        "\"When the wormhole unfolded, you called Yuda. It first asked you if you had remembered your address, and then reminded you to bring your mobile phone.\""
      ],
      "tasks": [
        {
          "id": "4B59D23DB73ED97B",
          "type": "custom",
          "title": "Successfully established an outbound wormhole through DHD",
          "tags": [
            "hk3gtl_candidate_stargate_dial",
            "hk3gtl_quest_stargate_dial"
          ]
        }
      ],
