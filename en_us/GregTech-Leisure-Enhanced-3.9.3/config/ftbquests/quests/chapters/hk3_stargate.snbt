    {
      "id": "4B5ED88C534BA149",
      "title": "stand up the door",
      "subtitle": "The first functional classic stargate",
      "description": [
        "\"Build the parts into a complete classic stargate and activate the base in the bottom center.\"",
        "\"The parts that were originally piled in the warehouse finally formed a circle outside the factory. You took a few steps back to take a look, and then walked over to check the base. Next, it's your turn to dial.\""
      ],
      "tasks": [
        {
          "id": "4B57BFB65232912B",
          "type": "custom",
          "title": "Actual activation of a complete classic star gate",
