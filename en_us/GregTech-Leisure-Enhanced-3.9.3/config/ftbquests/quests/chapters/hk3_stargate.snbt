    {
      "id": "4B59344AF2A873F5",
      "title": "Star Gate Crystal Slurry",
      "subtitle": "First take a bucket of samples",
      "description": [
        "\"Stargate crystal slurry is prepared in an ultra-dimensional mixing process. Production requires an absolutely ultra-clean room and must meet the gravity conditions of the formula.\"",
        "\"First inject a 1000 mB sample into the task screen bound to this task, and then arrange subsequent supply for the crystal base. The sample will be consumed after submission.\""
      ],
      "tasks": [
        {
          "id": "4B590FB811D47C7C",
