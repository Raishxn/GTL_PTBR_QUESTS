			]
			description: [
				"Gravitational wave antenna transmitter—broadcast mode effect description"
				"━━━━━━━━━━━━━━━━━━━━"
				""
				"📡Broadcast basic parameters"
				"━━━━━━━━━━━━━━━"
				"• Broadcast radius: 160 tiles (base, increased to 320 with lens)"
				"• Power level: 100/100 (Tier 9)"
				""
				"⚡ Machine effect within range"
				"━━━━━━━━━━━━━━━━━━━"
				""
				"① Lossless overclocking acceleration (must take effect)"
				"• Recipe time × 100 / (100 + power)"
				"• Time taken is halved when power=100 (2x speedup)"
				"• Attenuation with distance"
				""
				"② Gravitational lens copy output"
				"• No lens: Probability = power × 0.5% (upper limit 50%), output 2x power = voltage level"
				"• With lens: 2x = 100% trigger, 3x by probability"
				"• 3x probability = number of lenses / 16 × 100%"
				"• 3x = 100% must trigger for 16 lenses"
				""
				"🔮 Lens slot (GUI slot in the upper right corner)"
				"━━━━━━━━━━━━━━━━━━━━━━━"
				"•Put in items: Gravitational Distortion Lens ( dishanhai:gravitational_lens )"
				"• Maximum slots: 16"
				"• +10 tiles broadcast radius per lens"
				"• 16 chip radius = 320 blocks"
				""
				"┌─────────────┬──────────┬──────────┬──────────┐"
				"│ Number of lenses │ 2x probability │ 3x probability │ Worst magnification │"
				"├─────────────┼──────────┼──────────┼──────────┤"
				"│ 0 │ ≤50% │ 0% │ None │"
				"│  1          │ 100%     │  6%      │  2x      │"
				"│  4          │ 100%     │  25%     │  2x      │"
				"│  8          │ 100%     │  50%     │  2x      │"
				"│  12         │ 100%     │  75%     │  2x      │"
				"│  16         │ 100%     │  100%    │  3x      │"
				"└─────────────┴──────────┴──────────┴──────────┘"
				""
				"🌋Monster Blocking"
				"━━━━━━━━━━━"
				"• No natural mobs allowed within broadcast range"
			]
