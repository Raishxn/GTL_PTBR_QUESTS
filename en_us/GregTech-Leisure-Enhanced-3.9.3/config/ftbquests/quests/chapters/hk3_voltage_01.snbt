      ],
      "icon": "hk3gtl:prototype_honkai_detector",
      "x": 8,
      "y": 0
    },
    {
      "id": "4B5D3AE78A2F4B44",
      "title": "Honkai Energy Harvesting Tower Controller",
      "subtitle": "Let the liquid air pass through here",
      "description": "[
        \"First build the collection tower controller, and then connect the structure, fluid interface and MAX power supply. The trial detector will remain in the tower and will continue to be used during sampling.\"
      ]",
      "tasks": [
        {
          "id": "4B527F35045CA57E",
          "type": "item",
