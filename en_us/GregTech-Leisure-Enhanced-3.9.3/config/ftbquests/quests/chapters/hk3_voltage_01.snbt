      "x": 8,
      "y": 4
    },
    {
      "id": "4B52B08CFC461F2C",
      "title": "Honkai recognition",
      "subtitle": "A little bit left in a million barrels",
      "description": "[
        \"Each batch of the collection tower consumes 1,000,000 mB of liquid air and extracts 100 mB of liquid collapse energy. You can start by reading Otto's observation data. It is up to you to decide whether to accept cooperation.\",
        \"After the first batch of real samples come out, go to the research institute to complete Honkai energy identification. The detector will be retained during this process.\"
      ]",
      "tasks": [
        {
          "id": "4B546F275EF1842E",
          "type": "custom",
          "title": "Honkai energy recognition completed",
          "tags": [
            "hk3gtl_quest_rn_hed"
