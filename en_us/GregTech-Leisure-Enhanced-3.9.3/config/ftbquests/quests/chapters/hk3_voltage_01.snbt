        }
      ],
      "dependencies": [
        "4B5599133D72B718"
      ],
      "icon": "hk3gtl:cryogenic_sampling_chamber",
      "x": 4,
      "y": 0
    },
    {
      "id": "4B5146F8FCC2CB66",
      "title": "Prototype collapse energy detector",
      "subtitle": "Start with that abnormal reading",
      "description": "[
        \"Install the sampling cavity and differential measurement components into the detector. The observation data sent by Otto gives us a direction. Next, we have to rely on our own instruments to find it.\"
      ]",
      "tasks": [
        {
          "id": "4B5DA6B439B42E27",
