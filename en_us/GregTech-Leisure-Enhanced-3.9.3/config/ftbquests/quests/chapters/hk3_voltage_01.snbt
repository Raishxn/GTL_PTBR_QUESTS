    {
      "id": "4B51A5DD7757E7FA",
      "title": "Sampling and measurement components",
      "subtitle": "Make the instrument first",
      "description": "[
        \"First make the low-temperature sampling chamber and the differential measurement component. The sampling chamber is responsible for retaining samples, and the differential measurement component is responsible for comparing readings. They are used by the detector and the first few facilities.\"
      ]",
      "tasks": [
        {
          "id": "4B5C8A6C4E508531",
