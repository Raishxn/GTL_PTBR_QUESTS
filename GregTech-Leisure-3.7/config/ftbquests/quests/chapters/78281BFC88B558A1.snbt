			x: -3.5d
			y: -8.0d
		}
		{
			description: [
				"Esta é a chave para a entrada e saída de estruturas multibloco. Ônibus/caixas/conjuntos mais avançados proporcionarão mais espaço."
				""
				"O barramento/bin/conjunto também vem com funções automáticas de entrada e saída &d &r, que podem ser controladas por interruptores."
			]
			icon: "gtceu:lv_input_bus"
			id: "5DB8BE71B3733C36"
