		{
			dependencies: [
				"0847D3D95772DD9D"
				"1A44CDF26D586B07"
			]
			description: [
				"Transmissor de antena de ondas gravitacionais - descrição do efeito do modo de transmissão"
				"━━━━━━━━━━━━━━━━━━━━"
				""
				"📡Parâmetros básicos de transmissão"
				"━━━━━━━━━━━━━━━"
				"• Raio de transmissão: 160 blocos (base, aumentado para 320 com lente)"
				"• Nível de potência: 100/100 (Nível 9)"
				""
				"⚡ Efeito de máquina dentro do alcance"
				"━━━━━━━━━━━━━━━━━━━"
				""
				"① Aceleração de overclock sem perdas (deve entrar em vigor)"
				"• Tempo de receita × 100 / (100 + potência)"
				"• O tempo gasto é reduzido pela metade quando potência = 100 (2x aceleração)"
				"• Atenuação com distância"
				""
				"② Saída de cópia de lente gravitacional"
				"• Sem lente: Probabilidade = potência × 0,5% (limite superior de 50%), saída 2x potência = nível de tensão"
				"• Com lente: 2x = 100% de disparo, 3x por probabilidade"
				"• Probabilidade 3x = número de lentes / 16 × 100%"
				"• 3x = 100% deve ser acionado para 16 lentes"
				""
				"🔮 Slot de lente (slot GUI no canto superior direito)"
				"━━━━━━━━━━━━━━━━━━━━━━━"
				"•Incluir itens: Lente de Distorção Gravitacional ( dishanhai:gravitational_lens )"
				"• Máximo de slots: 16"
				"• +10 raios de transmissão de blocos por lente"
				"• Raio de 16 chips = 320 blocos"
				""
				"┌─────────────┬──────────┬──────────┬──────────┐"
				"│ Número de lentes │ Probabilidade 2x │ Probabilidade 3x │ Pior ampliação │"
				"├─────────────┼──────────┼──────────┼──────────┤"
				"│ 0 │ ≤50% │ 0% │ Nenhum │"
				"│  1          │ 100%     │  6%      │  2x      │"
				"│  4          │ 100%     │  25%     │  2x      │"
				"│  8          │ 100%     │  50%     │  2x      │"
				"│  12         │ 100%     │  75%     │  2x      │"
				"│  16         │ 100%     │  100%    │  3x      │"
				"└─────────────┴──────────┴──────────┴──────────┘"
				""
				"🌋Bloqueio de Monstro"
				"━━━━━━━━━━━"
				"• Não são permitidos mobs naturais dentro da área de transmissão"
			]
