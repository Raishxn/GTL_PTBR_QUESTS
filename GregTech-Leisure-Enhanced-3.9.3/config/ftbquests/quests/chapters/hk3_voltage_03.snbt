    {
      "id": "4B5DA21B24CF30E1",
      "title": "matriz de interconexão cerâmica",
      "subtitle": "Passe a linha pela camada de isolamento",
      "description": [
        "Ative a parede do furo, deposite a camada condutora e, em seguida, conecte os fios centrais e as interconexões de superfície. Novos circuitos, detectores e invólucros HRV devem ser obtidos aqui."
      ],
