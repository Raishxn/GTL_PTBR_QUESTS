  "quests": [
    {
      "id": "4B51EEA9FC0829EF",
      "title": "Continuação do workshop de imprensa de contenção",
      "subtitle": "Revestimento, polimerização, recozimento e, em seguida, para rede ressonante",
      "description": [
        "O invólucro HCV e a nanotecnologia front-end estão prontos. Nesta etapa, serão integrados a polimerização, o recozimento e o processamento de precisão do aço alma e, em seguida, serão fabricados a rede ressonante e o primeiro lote de invólucros HRV.",
        "“Existem injetores que continuam fornecendo HW. O grupo de revestimento tem lote de 192 mil HW, e o de polimerização bruta e recozimento tem 460,8 mil HW cada."
      ],
      "tasks": [
        {
          "id": "4B54BBF74370B91C",
          "type": "item",
          "item": "hk3gtl:voltage_machine_casing_hcv",
          "count": 1,
          "consume_items": false
        },
