    },
    {
      "id": "4B52CD74565E718E",
      "title": "Pré-fabricação de componentes maravilhosos",
      "subtitle": "Montagem de quatro tipos de materiais compósitos em componentes pré-fabricados universais",
      "description": "[
        “Envie os quatro materiais compósitos de orientação energética, restrição, reconstrução e cognição para o equipamento pré-fabricado e encaixe-os no invólucro IRV. Colete os componentes pré-fabricados, sobras de materiais e refrigerante quente, salve o registro pré-fabricado real e continue a pesquisa sobre o método de aceitação do projeto.
      ]",
      "dependencies": [
        "4B5750C272E75E18",
