    {
      "id": "4B51A5DD7757E7FA",
      "title": "Componentes de amostragem e medição",
      "subtitle": "Faça o instrumento primeiro",
      "description": [
        "“Primeiro faça a câmara de amostragem de baixa temperatura e o componente de medição diferencial. A câmara de amostragem é responsável por reter as amostras, e o componente de medição diferencial é responsável por comparar as leituras."
      ],
      "tasks": [
