    {
      "id": "4B5D3AE78A2F4B44",
      "title": "Controlador de torre de coleta de energia Honkai",
      "subtitle": "Deixe o ar líquido passar por aqui",
      "description": [
        "\"Primeiro construa o controlador da torre de coleta e, em seguida, conecte a estrutura, a interface do fluido e a fonte de alimentação MAX. O detector de teste permanecerá na torre e continuará a ser usado durante a amostragem.\""
      ],
