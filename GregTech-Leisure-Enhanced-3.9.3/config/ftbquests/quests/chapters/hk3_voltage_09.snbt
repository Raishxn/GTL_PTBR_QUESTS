      "x": 46,
      "y": 8,
      "optional": false
    },
    {
      "id": "4B51E08379C2635B",
      "title": "Placa de circuito impresso de topologia imaginária",
      "subtitle": "O desenvolvimento da linha é feito separadamente",
      "description": [
        "\"Envie o substrato laminado para uma máquina de imersão química para desenvolvimento e retire a saída da solução de gravação residual. Após a conclusão do circuito impresso, instale o conjunto de patches e o chip de interface de fase.\""
      ],
      "dependencies": [
        "4B5D8A011ADB9399"
      ],
