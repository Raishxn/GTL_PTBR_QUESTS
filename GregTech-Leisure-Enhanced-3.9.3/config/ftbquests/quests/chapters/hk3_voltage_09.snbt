  "quests": [
    {
      "id": "4B5B68B8C11CA404",
      "title": "Continuar do workshop QAV",
      "subtitle": "QAV → IMV",
      "description": [
        "\"O chassi frontal está pronto. Este capítulo continua conectando os principais materiais, eletrônicos e instalações para criar o primeiro lote de cubos mecânicos IMV.\"",
        "“Primeiro conecte a linha de produção de material principal e, em seguida, organize o processo de fusão após a reciclagem e o reforço. Verifique JEI quanto a materiais, energia e condições de trabalho."
      ],
      "dependencies": [
        "4B5792CC8C53B87D"
      ],
      "tasks": [
