      "x": 30,
      "y": 8,
      "optional": false
    },
    {
      "id": "4B50716301E829FE",
      "title": "Rede de interconexão dirigida por topologia imaginária",
      "subtitle": "Conecte cada área de trabalho individualmente",
      "description": [
        "“A unidade de conexão da rede de interconexão da plataforma frontal é usada, e ramais independentes são conectados com fios finos de compósito cerâmico. O filme dielétrico é deixado entre cada ramal para posterior uso do substrato e da matriz funcional."
      ],
      "dependencies": [
        "4B5487FC42B1F9B4",
        "4B5E86444626FE39"
      ],
      "tasks": [
