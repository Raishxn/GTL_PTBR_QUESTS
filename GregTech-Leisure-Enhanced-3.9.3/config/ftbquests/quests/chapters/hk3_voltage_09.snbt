    },
    {
      "id": "4B5487FC42B1F9B4",
      "title": "Filme de isolamento dielétrico de topologia imaginária",
      "subtitle": "Separe primeiro o limite da fase cerâmica",
      "description": [
        "\"Uma nova folha de cerâmica é aplicada a um filme dielétrico quântico coerente, seguido por um revestimento dielétrico de nível de corrente. O filme acabado é responsável pelo isolamento entre as áreas de trabalho do circuito de topologia imaginária.\""
      ],
      "dependencies": [
        "4B54804DF6CCFEB5",
        "4B5313D7F4421690"
      ],
      "tasks": [
        {
          "id": "4B50F1BD2D822F94",
