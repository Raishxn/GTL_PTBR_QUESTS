    },
    {
      "id": "4B5D8A011ADB9399",
      "title": "Substrato de circuito de topologia de número imaginário",
      "subtitle": "Pressione o novo circuito no substrato físico",
      "description": [
        "“O substrato da plataforma frontal serve de base, e a placa impressa retém a interface antiga. O novo filme, a rede de interconexão e a camada de gravação são laminados juntos para obter o substrato transportador para o circuito de topologia imaginária."
      ],
      "dependencies": [
        "4B50716301E829FE"
      ],
      "tasks": [
        {
          "id": "4B596E767771C7D1",
