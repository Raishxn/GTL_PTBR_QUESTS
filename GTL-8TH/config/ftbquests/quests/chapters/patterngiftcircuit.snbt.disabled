							Lore: [
								"{\"text\":\"----------------\",\"color\":\"dark_gray\",\"italic\":false}"
								"{\"text\":\"Este modelo pré-fabricado é usado apenas para estruturas multiblocos de fornos de fundição de ligas.\",\"color\":\"gray\",\"italic\":false}"
								"{\"text\":\"Clique com o botão direito no conjunto da superamostra dentro da estrutura multibloco do forno de fundição de liga.\",\"color\":\"gray\",\"italic\":false}"
								"{\"text\":\"\",\"italic\":false}"
								"{\"text\":\"[Descrição da amostra]\",\"color\":\"gold\",\"italic\":false,\"bold\":true}"
								"{\"text\":\"A maioria das amostras e catalisadores dos fornos de fundição de ligas foram configurados internamente.\",\"color\":\"yellow\",\"italic\":false}"
								"{\"text\":\"\",\"italic\":false}"
								"{\"text\":\"⚠ Este item é um item de uso único. Clique com o botão direito com cuidado.\",\"color\":\"red\",\"italic\":false}"
								"{\"text\":\"Se não estiver em uso, coloque-o em uma caixa separada\",\"color\":\"red\",\"italic\":false}"
								"{\"text\":\"Não coloque em AE, isso fará com que o NBT exploda.\",\"color\":\"red\",\"italic\":false}"
								"{\"text\":\"----------------\",\"color\":\"dark_gray\",\"italic\":false}"
							]
							Name: "{\"text\":\"Amostra pré-fabricada em forno de fundição de liga\",\"italic\":false,\"color\":\"aqua\"}"
