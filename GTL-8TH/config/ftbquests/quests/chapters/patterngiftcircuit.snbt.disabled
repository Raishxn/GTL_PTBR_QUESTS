								"{\"text\":\"\",\"italic\":false}"
								"{\"text\":\"[Tipo de caldeira incluído]\",\"color\":\"gold\",\"italic\":false,\"bold\":true}"
								"{\"text\":\"Placa, haste, bloco, engrenagem, anel, parafuso\",\"color\":\"yellow\",\"italic\":false}"
								"{\"text\":\"Micro tubos, tubos pequenos, tubos comuns\",\"color\":\"yellow\",\"italic\":false}"
								"{\"text\":\"gasoduto grande, gasoduto gigante\",\"color\":\"yellow\",\"italic\":false}"
								"{\"text\":\"peça, haste longa, rotor\",\"color\":\"yellow\",\"italic\":false}"
								"{\"text\":\"\",\"italic\":false}"
								"{\"text\":\"⚠ Este item é um item de uso único. Clique com o botão direito com cuidado.\",\"color\":\"red\",\"italic\":false}"
								"{\"text\":\"Se não estiver em uso, coloque-o em uma caixa separada\",\"color\":\"red\",\"italic\":false}"
								"{\"text\":\"Não coloque em AE, isso fará com que o NBT exploda.\",\"color\":\"red\",\"italic\":false}"
								"{\"text\":\"----------------\",\"color\":\"dark_gray\",\"italic\":false}"
							]
							Name: "{\"text\":\"Modelo pré-fabricado com carimbo\",\"italic\":false,\"color\":\"aqua\"}"
						}
					}
				}
				type: "item"
			}]
