								"{\"text\":\"----------------\",\"color\":\"dark_gray\",\"italic\":false}"
								"{\"text\":\"Esta amostra pré-fabricada é usada apenas para a estrutura multibloco da calandra de chapa.\",\"color\":\"gray\",\"italic\":false}"
								"{\"text\":\"Clique com o botão direito no conjunto da superamostra na estrutura multibloco da laminadora de placas.\",\"color\":\"gray\",\"italic\":false}"
								"{\"text\":\"\",\"italic\":false}"
								"{\"text\":\"[Tipo de caldeira incluído]\",\"color\":\"gold\",\"italic\":false,\"bold\":true}"
								"{\"text\":\"Molas pequenas, molas, placas de dupla camada, folhas\",\"color\":\"yellow\",\"italic\":false}"
								"{\"text\":\"\",\"italic\":false}"
								"{\"text\":\"⚠ Este item é um item de uso único. Clique com o botão direito com cuidado.\",\"color\":\"red\",\"italic\":false}"
								"{\"text\":\"Se não estiver em uso, coloque-o em uma caixa separada\",\"color\":\"red\",\"italic\":false}"
								"{\"text\":\"Não coloque em AE, isso fará com que o NBT exploda.\",\"color\":\"red\",\"italic\":false}"
								"{\"text\":\"----------------\",\"color\":\"dark_gray\",\"italic\":false}"
							]
							Name: "{\"text\":\"Modelo pré-fabricado para máquina de laminação de placas\",\"italic\":false,\"color\":\"aqua\"}"
						}
					}
				}
				type: "item"
			}]
