								"{\"text\":\"----------------\",\"color\":\"dark_gray\",\"italic\":false}"
								"{\"text\":\"Este modelo pré-fabricado é apenas para estruturas multiblocos de linha de montagem.\",\"color\":\"gray\",\"italic\":false}"
