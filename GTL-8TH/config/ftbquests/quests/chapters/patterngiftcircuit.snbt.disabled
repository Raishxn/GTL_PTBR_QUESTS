							Lore: [
								"{\"text\":\"----------------\",\"color\":\"dark_gray\",\"italic\":false}"
								"{\"text\":\"Esta amostra pré-fabricada é usada apenas para a estrutura multibloco do laminador de fio-máquina.\",\"color\":\"gray\",\"italic\":false}"
								"{\"text\":\"Clique com o botão direito no conjunto da superamostra na estrutura multibloco do laminador de fio-máquina.\",\"color\":\"gray\",\"italic\":false}"
								"{\"text\":\"\",\"italic\":false}"
								"{\"text\":\"[Tipo de caldeira incluído]\",\"color\":\"gold\",\"italic\":false,\"bold\":true}"
								"{\"text\":\"Fio fino, cabo 1X, cabo 2X, cabo 4X, cabo 8X, cabo 16X\",\"color\":\"yellow\",\"italic\":false}"
								"{\"text\":\"\",\"italic\":false}"
								"{\"text\":\"⚠ Este item é um item de uso único. Clique com o botão direito com cuidado.\",\"color\":\"red\",\"italic\":false}"
								"{\"text\":\"Se não estiver em uso, coloque-o em uma caixa separada\",\"color\":\"red\",\"italic\":false}"
								"{\"text\":\"Não coloque em AE, isso fará com que o NBT exploda.\",\"color\":\"red\",\"italic\":false}"
								"{\"text\":\"----------------\",\"color\":\"dark_gray\",\"italic\":false}"
							]
