								"{\"text\":\"Este modelo pré-fabricado é apenas para estruturas multibloco de torno.\",\"color\":\"gray\",\"italic\":false}"
								"{\"text\":\"Clique com o botão direito na montagem da superamostra na estrutura multibloco do torno\",\"color\":\"gray\",\"italic\":false}"
