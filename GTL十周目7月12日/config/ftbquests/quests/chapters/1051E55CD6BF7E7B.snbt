					type: "item"
				}
			]
			title: "Eu sempre estarei com você"
			x: 15.0d
			y: 3.0d
		}
		{
			dependencies: ["516498830339A0A9"]
			description: [
				"Parabéns por completar o jogo e obrigado por jogar."
